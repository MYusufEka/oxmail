# =============================================================================
# Oxmail Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables are prefixed with OXMAIL_ for namespacing.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Mode: "dev" or "production"
# dev = relaxed auth, local ports, no DNS required
# production = TLS, real ports, outbound mail enabled
OXMAIL_MODE=dev

# Primary mail domain (e.g., example.com or local.test for dev)
OXMAIL_DOMAIN=local.test

# Admin password for first-run setup (min 8 characters)
OXMAIL_ADMIN_PASSWORD=changeme123

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# API server port (default: 8080)
OXMAIL_API_PORT=8080

# Web UI port (default: 3000)
OXMAIL_WEB_PORT=3000

# SMTP port (default: 1025 for dev, 25 for production)
OXMAIL_SMTP_PORT=1025

# IMAP port (default: 1143 for dev, 993 for production)
OXMAIL_IMAP_PORT=1143

# POP3 port (default: 1100 for dev, 110 for production)
OXMAIL_POP3_PORT=1100

# -----------------------------------------------------------------------------
# Production Only
# -----------------------------------------------------------------------------

# Public IP address (required for production SPF/rDNS)
# OXMAIL_PUBLIC_IP=

# Let's Encrypt email for TLS certificates
# OXMAIL_ACME_EMAIL=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis URL (default uses internal Docker network)
OXMAIL_REDIS_URL=redis://redis:6379
